  {
    "path": "/",
    "contains": ["<h1", "rel=\"canonical\" href=\"https://rogerdhillon.com\"", "calendly.com/rogerdhillon", "application/ld+json"],
    "headers": { "x-content-type-options": "nosniff", "strict-transport-security": "max-age=", "x-frame-options": "DENY" }
